[Unit]
Description=Python KOReader Sync Server
After=network.target

[Service]
Type=simple
User=koreader-sync
Group=koreader-sync
StateDirectory=koreader-sync-server
ConfigurationDirectory=koreader-sync-server
ExecStart=/usr/bin/koreader-sync-server --config /etc/koreader-sync-server/config.toml
Restart=on-failure
RestartSec=5s
ProtectHome=read-only
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
