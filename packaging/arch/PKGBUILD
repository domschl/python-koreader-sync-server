# PKGBUILD for python-koreader-sync-server
pkgname=python-koreader-sync-server
pkgver=0.2.0
pkgrel=1
pkgdesc="A lightweight KOReader sync server backend in Python with reverse ebook resolution and Biograph telemetry"
arch=('any')
url="https://github.com/domschl/python-koreader-sync-server"
license=('GPL3')
depends=('python' 'python-aiohttp' 'python-watchdog')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel' 'git')
source=("git+https://github.com/domschl/python-koreader-sync-server.git")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  rm -rf dist
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname"
  python -m installer --destdir="$pkgdir" dist/python_koreader_sync_server-"$pkgver"-*.whl

  install -Dm644 systemd/koreader-sync-server.service "$pkgdir/usr/lib/systemd/system/koreader-sync-server.service"
  install -Dm644 systemd/koreader-sync-server.sysusers "$pkgdir/usr/lib/sysusers.d/koreader-sync-server.conf"
  install -Dm644 config.example.toml "$pkgdir/etc/koreader-sync-server/config.toml.example"
}
